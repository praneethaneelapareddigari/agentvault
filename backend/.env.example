# Copy to .env and fill in as needed.
# If ANTHROPIC_API_KEY is unset, the Intent Agent and Verification Agent
# automatically fall back to deterministic rule-based logic so the whole
# pipeline still runs end-to-end without any API key.
ANTHROPIC_API_KEY=

# Defaults to local SQLite. Point this at Postgres in production:
# postgresql://user:pass@localhost:5432/agentvault
DATABASE_URL=sqlite:///./agentvault.db

# Comma separated list of chains supported in this MVP
SUPPORTED_CHAINS=ethereum,base,arbitrum

# Demo/hero-path chain (live execution path is optimized for this one)
PRIMARY_CHAIN=base

# ---------------------------------------------------------------------------
# Real on-chain execution (Base Sepolia). Leave EXECUTION_MODE=mock (default)
# to run the full pipeline with zero setup — wallet balances, simulation, and
# execution are all deterministic mocks. Set EXECUTION_MODE=real and fill in
# the rest of this block to send actual transactions on Base Sepolia.
# ---------------------------------------------------------------------------
EXECUTION_MODE=mock

# Get a free RPC URL from Alchemy, Infura, or use the public endpoint:
# https://sepolia.base.org
BASE_SEPOLIA_RPC_URL=

# Private key of a wallet ONLY used as the backend relayer — fund it with a
# little Base Sepolia ETH for gas (never use a wallet holding real funds).
# Get testnet ETH: https://www.alchemy.com/faucets/base-sepolia
RELAYER_PRIVATE_KEY=

# Set after running: cd contracts && npm run deploy:base-sepolia
POLICY_VAULT_ADDRESS=

# Aave V3 Pool Proxy on Base Sepolia — verified on BaseScan, safe to leave
# as-is unless Aave redeploys their testnet market.
AAVE_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5

# Testnet USDC address for the Aave Base Sepolia market. Get one (and test
# USDC) from the Aave testnet faucet:
# https://bridge-testnet.aave.com/faucet/?marketName=proto_base_sepolia_v3
USDC_ADDRESS_BASE_SEPOLIA=
